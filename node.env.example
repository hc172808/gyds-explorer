# Copy to /etc/gyds/node.env on an Ubuntu node.
# This file contains configuration only. Never put private keys or passwords here.

NODE_TYPE=main
NODE_NAME=gyds-main-01

CHAIN_ID=198282
NETWORK_ID=198282
# GYDS native precision. Must remain 18 — node-setup.sh refuses anything else.
NATIVE_DECIMALS=18
NATIVE_SUPPLY=1000000000

DATA_DIR=/var/lib/gyds
CONFIG_DIR=/etc/gyds
LOG_DIR=/var/log/gyds

RPC_PORT=8545
WS_PORT=8546
P2P_PORT=30303
METRICS_PORT=6060

# Required for full, rpc, lite, and validator nodes:
# MAIN_NODE_IP=
# MAIN_NODE_ENODE=
# FULL_NODE_IPS=

# Required for validator nodes. Keep the password out of this file.
# VALIDATOR_ADDRESS=

# MAIN node only — admin (founder) wallet for the explorer Admin Dashboard.
# Leave ADMIN_WALLET empty to have node-setup.sh create a new keystore wallet.
# ADMIN_WALLET=0x0000000000000000000000000000000000000000
# ADMIN_WALLET_LABEL=Founder
# ADMIN_SUPPLY=1000000                       # GYDS credited to the admin wallet in genesis (0 = none)
# EXPLORER_API_URL=http://127.0.0.1:3001/api # where the wallet is auto-registered

# ---------- Performance ----------
# CACHE_SIZE=1024
# MAX_PEERS=50

# ---------- Security ----------
# yes = RPC/WS ports opened to the internet, no = localhost/VPN only (recommended)
# PUBLIC_RPC=no

# ---------- Backups & health ----------
# BACKUP_DIR=/var/backups/gyds
# BACKUP_KEEP=7
# HEALTH_MIN_PEERS=1
# HEALTH_STALL_SECONDS=300
