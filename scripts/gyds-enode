#!/usr/bin/env bash
set -euo pipefail

if [ "${EUID}" -ne 0 ]; then
  echo "Run this command with sudo: sudo gyds-enode" >&2
  exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HELPERS_FILE="${SCRIPT_DIR}/node-setup-helpers.sh"
[ -r "${HELPERS_FILE}" ] || HELPERS_FILE="/usr/local/lib/gyds/node-setup-helpers.sh"
[ -r "${HELPERS_FILE}" ] || {
  echo "GYDS node setup helpers are missing; rerun node-setup.sh." >&2
  exit 1
}
source "${HELPERS_FILE}"

source /etc/gyds/node.env
DATA_DIR="${DATA_DIR:-/var/lib/gyds}"
IPC_PATH="${DATA_DIR}/geth.ipc"

if ! systemctl is-active --quiet gyds-node; then
  echo "GYDS node is stopped; starting gyds-node..."
  systemctl start gyds-node || true
fi

for _ in $(seq 1 30); do
  if systemctl is-active --quiet gyds-node && [ -S "${IPC_PATH}" ]; then
    ENODE_OUTPUT="$(geth attach --exec 'admin.nodeInfo.enode' "${IPC_PATH}" 2>&1)" || {
      echo "Failed to read enode from the Geth IPC socket:" >&2
      echo "${ENODE_OUTPUT}" >&2
      exit 1
    }
    ENODE="$(gyds_normalize_enode_output "${ENODE_OUTPUT}")"
    if gyds_is_valid_enode_url "${ENODE}"; then
      printf '%s\n' "${ENODE}"
      exit 0
    fi
    echo "Geth returned an invalid enode URL; refusing to print it." >&2
    exit 1
  fi
  sleep 1
done

echo "GYDS node did not become ready; no IPC socket found at ${IPC_PATH}." >&2
echo "Recent service logs:" >&2
journalctl -u gyds-node -n 50 --no-pager >&2 || true
exit 1