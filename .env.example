# Node connection mode: local = this server only, remote = configured remote
# nodes only, auto = this server first then remote fallbacks.
GYDS_RPC_MODE=auto
GYDS_LOCAL_RPC_URL=http://127.0.0.1:8545
GYDS_REMOTE_RPC_URL=
GYDS_REMOTE_RPC_URL_2=
GYDS_MAINNET_RPC_URL=http://127.0.0.1:8545
GYDS_MAINNET_RPC_URL_2=
GYDS_TESTNET_RPC_URL=http://127.0.0.1:9545
GYDS_TESTNET_RPC_URL_2=
# Private, server-to-node endpoint for the faucet. Keep this inaccessible from the internet.
GYDS_TESTNET_FAUCET_RPC_URL=http://127.0.0.1:9545
GYDS_TESTNET_FAUCET_ENABLED=false
GYDS_TESTNET_TGYD_TOKEN_ADDRESS=
GYDS_NODE_ENODE=
GYDS_MAINNET_CHAIN_ID=198282

# Public explorer RPC configuration (legacy aliases are still supported)
# Keep /api when UI and API share an origin. For separate UI hosting, set this
# to the API server origin (or its /api URL) when building the web app.
VITE_API_BASE_URL=/api
# On the API server, optionally restrict browser access to the separate UI origin:
# CORS_ALLOWED_ORIGINS=https://explorer.example.com
# VITE_RPC_URL is the browser's same-origin proxy path, not an indexer RPC URL.
VITE_RPC_URL=/api/rpc
VITE_RPC_URL_2=/api/rpc
VITE_BOOSTNODE_RPC_URL=/api/rpc
RPC_URL=
RPC_URL_2=
BOOSTNODE_RPC_URL=
# Optional local gateway / node aliases.
RPC_LOCAL_URL=http://127.0.0.1:8545
# auto = compatible upstream first, then deterministic mock fallback.
RPC_MODE=auto
RPC_MOCK_FALLBACK=true
VITE_CHAIN_ID=198282
VITE_TESTNET_ADMIN_WALLET=0x6422d12bfaddee5142bfad21b3006a74d09017b1

# Block indexer
POLL_INTERVAL=5
BATCH_SIZE=10

# API production settings
API_HOST=127.0.0.1
TRUST_PROXY_HOPS=1
API_RPC_RATE_LIMIT=300
API_AUTH_RATE_LIMIT=20

# Public wallet and asset metadata (replace RPC/logo values for production)
VITE_NATIVE_COIN_NAME=GYDSChain
VITE_NATIVE_COIN_SYMBOL=GYDS
VITE_NATIVE_COIN_DECIMALS=18
VITE_NATIVE_COIN_LOGO_URL=/assets/gyds-logo.svg
VITE_EXPLORER_URL=
VITE_GYD_NAME=GYD
VITE_GYD_SYMBOL=GYD
VITE_GYD_DECIMALS=6
VITE_GYD_LOGO_URL=/assets/gyd-logo.svg
VITE_GYD_TOKEN_ADDRESS=

# API_SECRET_KEY (or JWT_SECRET_KEY / legacy JWT_SECRET / SESSION_SECRET) must be supplied through Replit Secrets.