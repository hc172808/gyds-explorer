# Copy to node.testnet.env or /etc/gyds-testnet/node.env before first setup.
# Run the setup explicitly with NETWORK_ENV=testnet.
NETWORK_ENV=testnet
NODE_TYPE=main
NODE_NAME=gyds-testnet-main-01

CHAIN_ID=198281
NETWORK_ID=198281
NATIVE_DECIMALS=18
NATIVE_COIN_NAME=TGYDS
NATIVE_COIN_SYMBOL=TGYDS
NATIVE_SUPPLY=1000000
ADMIN_SUPPLY=5000
ADMIN_WALLET=0x6422d12bfaddee5142bfad21b3006a74d09017b

DATA_DIR=/var/lib/gyds-testnet
CONFIG_DIR=/etc/gyds-testnet
LOG_DIR=/var/log/gyds-testnet
BACKUP_DIR=/var/backups/gyds-testnet

RPC_PORT=9545
WS_PORT=9546
P2P_PORT=30304
METRICS_PORT=6061

# Do not expose the RPC to the public internet unless that is intentional.
PUBLIC_RPC=no
